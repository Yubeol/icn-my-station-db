# backend/.env 예시. 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.
# 값을 넣은 .env는 이 파일에 복사하지 않는다.

# --- 기본 ---
# mock: 가짜 데이터(기본값), db: 공유 RDS 조회
DATA_MODE=mock
# 프론트 주소. 배포 때만 JSON 배열로 쓴다(빈 값으로 두면 파싱 오류가 나므로 주석으로 둔다).
# CORS_ORIGINS=["http://localhost:5173"]
WS_PUSH_INTERVAL_SECONDS=5

# --- DB (DATA_MODE=db일 때) ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# --- 스마트 알림 쓰기 ---
# ALERT_WRITE_ENABLED: 감지한 알림을 smart_alerts에 실제로 쓸지. 기본 false(감지만 하고 쓰지 않음).
# docs/db-write-contract.md를 확인한 뒤 서버 한 곳에서만 true로 켠다.
ALERT_WRITE_ENABLED=false
# YOLO_WRITE_ENABLED: YOLO 인원 집계·제스처 이벤트를 demo_yolo_counts, demo_yolo_events에 실제로 쓸지.
# 기본 false(db 모드에서는 저장하지 않고, 판정 PATCH는 503). ALERT_WRITE_ENABLED와 따로 켜고 서버 한 곳에서만 true로 둔다.
YOLO_WRITE_ENABLED=false

# --- YOLO DEMO 연결 토큰 (docs/yolo-demo-contract.md 1.3) ---
# 비워 두면 /ws/yolo/camera, /ws/yolo/worker 연결은 모두 4401로 거부된다.
YOLO_CAMERA_TOKEN=
YOLO_WORKER_TOKEN=
